# EN: Copy to .env.local and fill in. NEVER commit real keys.
# PT: Copie para .env.local e preencha. NUNCA fazer commit das chaves reais.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# EN: International format, digits only / PT: Formato internacional, só dígitos
NEXT_PUBLIC_WHATSAPP=

# EN: "mock" simulates payments (dev). "live" calls the real operators.
# PT: "mock" simula pagamentos (desenvolvimento). "live" usa as operadoras reais.
PAYMENTS_MODE=mock
# EN: Or turn on only some real methods, e.g. "mpesa". PT: Ou ligar só alguns métodos reais, ex.: "mpesa".
PAYMENTS_LIVE_METHODS=

# EN: Shared secret the operators send in the x-webhook-secret header.
# PT: Segredo partilhado que as operadoras enviam no cabeçalho x-webhook-secret.
WEBHOOK_SECRET=

# M-Pesa (Vodacom) — 84 / 85 · https://developer.mpesa.vm.co.mz → My Profile
MPESA_API_KEY=
# EN: Public Key on one line, as shown in the portal. PT: Public Key numa só linha, como no portal.
MPESA_PUBLIC_KEY=
# EN: Sandbox 171717 · production: Eterna's merchant code (after Vodacom's Go Live).
# PT: Sandbox 171717 · produção: código de comerciante da Eterna (depois do Go Live da Vodacom).
MPESA_SERVICE_PROVIDER_CODE=171717
# sandbox | production
MPESA_ENV=sandbox
# EN: Optional, only if Vodacom gives other values. PT: Opcionais, só se a Vodacom indicar outros.
# MPESA_HOST=https://api.sandbox.vm.co.mz
# MPESA_ORIGIN=developer.mpesa.vm.co.mz

# mKesh (Tmcel) — 82 / 83
MKESH_API_KEY=
MKESH_MERCHANT_ID=

# EN: PostgreSQL connection. Empty = embedded PGlite in .data/pglite (development).
# PT: Ligação PostgreSQL. Vazio = PGlite embutido em .data/pglite (desenvolvimento).
DATABASE_URL=

# EN: Catalog import from Nexsory (current eterna.co.mz platform). Get it from the Nexsory dashboard.
# PT: Importação do catálogo da Nexsory (plataforma do eterna.co.mz actual). Obter no painel da Nexsory.
NEXSORY_STOREFRONT=
NEXSORY_API_KEY=

# EN: WhatsApp / SMS / e-mail sending. Not "live" = demo mode: codes are shown on screen (phase 6 connects providers).
# PT: Envio de WhatsApp / SMS / e-mail. Sem "live" = modo de demonstração: os códigos aparecem no ecrã.
MESSAGING_MODE=

# EN: Password of the demo team (Gestão · Definições → Carregar dados de exemplo). Users: demo.admin, demo.gestora02,
#     demo.gestora22, demo.atend02, demo.entregador. Change it here; never use it for real accounts.
# PT: Palavra-passe da equipa de exemplo. Utilizadores acima. Nunca usar em contas reais.
DEMO_PASSWORD=demo-eterna-2026

# EN: Installation code asked on /gestao/primeiro-acesso. REQUIRED online (set it in Vercel); optional locally.
# PT: Código pedido no primeiro acesso à gestão. OBRIGATÓRIO online (definir na Vercel); opcional em local.
ADMIN_SETUP_CODE=
